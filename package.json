{
  "name": "nobackend",
  "displayName": "NoBackend - Mock Server",
  "description": "%extension.description%",
  "version": "1.0.0",
  "publisher": "vitorbastosbn",
  "author": {
    "name": "Vitor Bastos",
    "email": "vitorbastosbn@gmail.com",
    "url": "https://github.com/vitorbastosbn"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vitorbastosbn/NoBackend.git"
  },
  "bugs": {
    "url": "https://github.com/vitorbastosbn/NoBackend/issues"
  },
  "homepage": "https://github.com/vitorbastosbn/NoBackend#readme",
  "screenshots": [
    {
      "src": "media/screenshot.png",
      "label": "NoBackend Mock Server Interface"
    }
  ],
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Web Development",
    "Other"
  ],
  "keywords": [
    "mock",
    "mockoon",
    "api",
    "rest",
    "http",
    "server",
    "testing",
    "json",
    "insomnia",
    "postman"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nobackend-sidebar",
          "title": "NoBackend",
          "icon": "media/icon-activitybar.svg"
        }
      ]
    },
    "views": {
      "nobackend-sidebar": [
        {
          "id": "nobackend-servers",
          "name": "%views.mockServers%",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "nobackend.openDashboard",
        "title": "%command.openDashboard%",
        "category": "NoBackend",
        "icon": "$(dashboard)"
      },
      {
        "command": "nobackend.openRoute",
        "title": "%command.openRoute%",
        "category": "NoBackend"
      },
      {
        "command": "nobackend.addServer",
        "title": "%command.addServer%",
        "category": "NoBackend",
        "icon": "$(plus)"
      },
      {
        "command": "nobackend.addRoute",
        "title": "%command.addRoute%",
        "category": "NoBackend",
        "icon": "$(plus)"
      },
      {
        "command": "nobackend.startServer",
        "title": "%command.startServer%",
        "category": "NoBackend",
        "icon": "$(play)"
      },
      {
        "command": "nobackend.stopServer",
        "title": "%command.stopServer%",
        "category": "NoBackend",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nobackend.startAll",
        "title": "%command.startAll%",
        "category": "NoBackend",
        "icon": "$(play-all)"
      },
      {
        "command": "nobackend.stopAll",
        "title": "%command.stopAll%",
        "category": "NoBackend",
        "icon": "$(primitive-square)"
      },
      {
        "command": "nobackend.deleteServer",
        "title": "%command.deleteServer%",
        "category": "NoBackend",
        "icon": "$(trash)"
      },
      {
        "command": "nobackend.deleteRoute",
        "title": "%command.deleteRoute%",
        "category": "NoBackend",
        "icon": "$(trash)"
      },
      {
        "command": "nobackend.openConfigFile",
        "title": "%command.openConfigFile%",
        "category": "NoBackend",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nobackend.addServer",
          "when": "view == nobackend-servers",
          "group": "navigation"
        },
        {
          "command": "nobackend.startAll",
          "when": "view == nobackend-servers",
          "group": "1_actions@1"
        },
        {
          "command": "nobackend.stopAll",
          "when": "view == nobackend-servers",
          "group": "1_actions@2"
        },
        {
          "command": "nobackend.openConfigFile",
          "when": "view == nobackend-servers",
          "group": "1_actions@3"
        }
      ],
      "view/item/context": [
        {
          "command": "nobackend.addRoute",
          "when": "view == nobackend-servers && viewItem =~ /^server-/",
          "group": "inline@1"
        },
        {
          "command": "nobackend.startServer",
          "when": "view == nobackend-servers && viewItem == server-stopped",
          "group": "inline@2"
        },
        {
          "command": "nobackend.stopServer",
          "when": "view == nobackend-servers && viewItem == server-running",
          "group": "inline@2"
        },
        {
          "command": "nobackend.deleteServer",
          "when": "view == nobackend-servers && viewItem =~ /^server-/",
          "group": "inline@3"
        },
        {
          "command": "nobackend.deleteRoute",
          "when": "view == nobackend-servers && viewItem == route-item",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "node test/verify-server.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}